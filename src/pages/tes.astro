---
const milestones = [
	{ year: '1887', title: 'A workshop by the river', text: 'Mara Ellery opens a small brass-and-wood instrument shop beside the Calder Canal. The first ledger lists three employees, one borrowed lathe, and a promise to repair what others would replace.' },
	{ year: '1912', title: 'The first factory', text: 'The workshop moves into a brick mill on Foundry Street. Ellery & Company begins making dependable measuring instruments for railways, schools, and local makers.' },
	{ year: '1946', title: 'A new generation', text: 'After the war, precision skills turn toward household tools. A staff library and paid apprenticeships become part of the firm’s working life.' },
	{ year: '1978', title: 'Beyond the factory gates', text: 'A regional network of repair counters and independent dealers brings the company’s products to a wider public—and keeps repairs close to home.' },
	{ year: '2000', title: 'Looking forward', text: 'A century closes with the same practical ambition: make useful things carefully, share knowledge freely, and leave room for the next generation.' },
];

const principles = [
	{ title: 'Useful by design', text: 'Begin with a real need. Make the answer clear, durable, and easy to maintain.' },
	{ title: 'People make the work', text: 'Craft, curiosity, and fair opportunity have shaped the business from its earliest days.' },
	{ title: 'Built to be repaired', text: 'A long life is better than a quick replacement. Keep parts in circulation and knowledge in reach.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="The history, people, and principles of Ellery & Company, 1887–2000." />
		<title>The Ellery Chronicle — Company Record</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="view-controls" role="group" aria-label="Choose layout">
			<span>LAYOUT</span>
			<button type="button" data-layout="page" aria-pressed="true">Page-like</button>
			<button type="button" data-layout="full" aria-pressed="false">Full screen</button>
		</div>
		<div class="paper">
			<div class="utility"><span>AN INDEPENDENT COMPANY RECORD</span><span>VOL. I · NO. 01</span><span>EST. 1887 · ARCHIVE EDITION</span></div>
			<header class="masthead" id="top">
				<p class="eyebrow">A living history of work, invention &amp; people</p>
				<a class="wordmark" href="#top">The Ellery Chronicle</a>
				<p class="masthead-note">THE STORY OF ELLERY &amp; COMPANY, 1887—2000</p>
			</header>
			<nav class="nav" aria-label="Main navigation">
				<a href="#story">Our story</a><a href="#timeline">The years</a><a href="#principles">Principles</a><a href="#record">Company record</a><a href="#contact">Correspondence</a>
			</nav>

			<main>
				<div class="edition-line"><span>THE ARCHIVE ISSUE</span><span>AN ILLUSTRATED COMPANY BIOGRAPHY</span><span>PRICE: ONE GOOD QUESTION</span></div>
				<section class="lead-grid" id="story">
					<article class="lead-copy">
						<p class="kicker">From a riverside workshop to a century of useful things</p>
						<h1>Made with care.<br /><em>Kept with purpose.</em></h1>
						<p class="dek">One small shop. Five generations of changing tools. A company shaped less by a single invention than by the people who kept asking, “Can we make it better?”</p>
						<div class="byline"><span>BY THE ELLERY ARCHIVE DESK</span><span>ILLUSTRATED COMPANY HISTORY</span></div>
						<p class="body-copy">In 1887, Mara Ellery rented a narrow room near the Calder Canal and set a brass sign above its door. She repaired instruments for millwrights and mapmakers. The work was exacting; the promise was simple: make it well, explain how it works, and stand behind it.</p>
						<p class="body-copy">That promise followed the business through a new factory, two world wars, a changing marketplace, and the arrival of the new millennium. This is not a story of uninterrupted triumph. It is a record of experiments, hard lessons, and everyday craft—told through the people and decisions that made Ellery &amp; Company.</p>
						<a class="read-link" href="#timeline">Continue through the years <span>→</span></a>
					</article>
					<aside class="lead-rail" aria-label="Advertisement and archive note">
						<div class="ad ad-tall"><span class="ad-label">A WORD FROM OUR SPONSORS</span><p class="ornament">✳</p><h2>THE CALDER<br />READING ROOM</h2><p>Good books, warm lamps, and a chair that knows your name.</p><a href="#contact">VISIT THE READING ROOM ↗</a><small>OPEN DAILY · EST. 1896</small></div>
						<div class="archive-note"><span class="stamp">ARCHIVE<br />NOTE Nº 1</span><p>Dates and details are drawn from company ledgers, letters, and oral histories.</p></div>
					</aside>
				</section>

				<section class="ticker" aria-label="Company facts"><div><strong>1887</strong><span>FOUNDED</span></div><div><strong>5</strong><span>GENERATIONS</span></div><div><strong>113</strong><span>YEARS IN THIS RECORD</span></div><div><strong>1</strong><span>GUIDING IDEA: MAKE IT LAST</span></div></section>

				<section class="timeline-section" id="timeline">
					<div class="section-heading"><span>THE COMPANY, IN BRIEF</span><h2>A century in the making</h2><p>Five moments from a much longer story.</p></div>
					<div class="timeline-layout">
						<div class="timeline-list">{milestones.map((item, index) => <article class="milestone"><div class="year">{item.year}<span>{String(index + 1).padStart(2, '0')}</span></div><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
						<aside class="side-ads" aria-label="Period-style advertisements">
							<div class="ad ad-box"><span class="ad-label">ADVERTISEMENT</span><h3>THE NORTH STAR<br /><em>POCKET COMPASS</em></h3><p>For finding your way there—and back again.</p><div class="compass" aria-hidden="true">N<br /><span>✦</span><br />S</div><a href="#record">SEE THE FIELD KIT →</a><small>PRECISION SINCE 1904</small></div>
							<div class="quote-ad"><span class="ad-label">A NOTE FROM THE TYPE SHOP</span><p>“A letter is a small thing with a long journey.”</p><small>— J. BELL, COMPOSITOR · 1931</small></div>
						</aside>
					</div>
				</section>

				<section class="principles" id="principles">
					<div class="section-heading light-heading"><span>WHAT WE CARRY FORWARD</span><h2>Our working principles</h2></div>
					<div class="principle-grid">{principles.map((item, index) => <article><span class="principle-number">0{index + 1} /</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
				</section>

				<section class="record-grid" id="record">
					<article class="record-copy"><p class="kicker">The particulars</p><h2>A company is more<br /><em>than its products.</em></h2><p class="body-copy">Ellery &amp; Company is a privately held maker and repair business founded in 1887 in Calder, England. Across its history, the firm has worked in precision instruments, practical household tools, and technical education. Its archive preserves product drawings, staff publications, correspondence, and the stories of the people behind the work.</p><a class="read-link" href="#contact">Ask the archive a question <span>→</span></a></article>
					<aside class="record-card"><span class="ad-label">COMPANY RECORD · 2000</span><dl><div><dt>Founded</dt><dd>1887, Calder</dd></div><div><dt>Founder</dt><dd>Mara Ellery</dd></div><div><dt>First trade</dt><dd>Instrument repair</dd></div><div><dt>Known for</dt><dd>Useful, repairable tools</dd></div><div><dt>Archive</dt><dd>Calder Works, Box 14</dd></div></dl><div class="seal" aria-label="Ellery and Company seal">E<br /><span>&amp;</span><br />C</div></aside>
				</section>

				<section class="bottom-ad" aria-label="Repair service advertisement"><div><span class="ad-label">A SMALL ANNOUNCEMENT</span><h2>Keep good things<br /><em>in good repair.</em></h2></div><div><p>Our repair counter is open to all—whether the mark on your tool says Ellery or not. Bring the broken, the curious, or simply a question.</p><a href="#contact">FIND THE REPAIR DESK ↗</a></div><span class="ad-star" aria-hidden="true">✳</span></section>

				<footer id="contact"><div class="footer-brand">The Ellery Chronicle<small>AN ARCHIVE OF WORK &amp; PEOPLE</small></div><p>Have a story, a photograph, or a correction for the record?<br /><a href="mailto:archive@ellery.example">Write to the archive desk →</a></p><div class="copyright">© 2000 ELLERY &amp; COMPANY · PRINTED WITH CARE IN CALDER<br />THIS EDITION IS PART OF AN ONGOING COMPANY HISTORY.</div></footer>
			</main>
		</div>
	</body>
</html>

<script>
	const layoutButtons = document.querySelectorAll<HTMLButtonElement>('[data-layout]');
	layoutButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const full = button.dataset.layout === 'full';
		document.body.classList.toggle('is-fullscreen', full);
		layoutButtons.forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
		});
	});
</script>

